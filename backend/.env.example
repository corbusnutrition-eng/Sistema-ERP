# Plantilla de variables de entorno del backend. Copia a `.env` y completa
# con valores reales — `.env` está en .gitignore y NUNCA debe commitearse.
#
# `backend/.env` estuvo commiteado en el historial de git (commit c3df086)
# antes de este endurecimiento de seguridad. Si ese es tu caso, asume
# comprometido TODO lo que contenía y rota cada secreto en el panel de Render.

# ── Entorno ───────────────────────────────────────────────────────────────────
# "production" activa validaciones estrictas de arranque (JWT_SECRET_KEY y
# CORS_ORIGINS se vuelven obligatorias, sin defaults inseguros).
ENVIRONMENT=development

# ── Autenticación (JWT) ────────────────────────────────────────────────────────
# Obligatoria en producción. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotarla invalida TODAS las sesiones activas (todo el staff re-loguea una vez).
JWT_SECRET_KEY=

# ── Base de datos ───────────────────────────────────────────────────────────────
# Local: postgresql://admin:adminpassword@localhost:5432/iptv_erp
DATABASE_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Obligatoria en producción. Lista de orígenes exactos separados por coma.
# NUNCA un regex comodín (https://.*\.onrender\.com) — dejaba pasar
# credenciales desde cualquier app alojada en Render, no solo la nuestra.
CORS_ORIGINS=
# Opcional y desaconsejado salvo necesidad puntual (previews de este mismo
# proyecto). Si se define, debe ser lo más restrictivo posible.
CORS_ORIGIN_REGEX=

# ── Cookies de sesión ──────────────────────────────────────────────────────────
# Dominio compartido entre frontend y backend, ej. ".tudominio.com" (con el
# punto inicial) cuando ambos son subdominios del mismo dominio propio. Vacío
# en desarrollo local (cookie de host, sin atributo Domain).
COOKIE_DOMAIN=

# ── Seguridad admin ────────────────────────────────────────────────────────────
# PIN de operaciones sensibles (ajuste de saldo, bloqueo de cliente, anular
# venta/pago, desactivar moneda). Sin valor por defecto: si falta, esos
# endpoints responden 503 en lugar de aceptar cualquier PIN.
MASTER_ADMIN_PIN=

# ── Cloudinary (comprobantes) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Telegram (alertas al equipo) ───────────────────────────────────────────────
# Opcionales: si ambas están vacías, las notificaciones se omiten en silencio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OCR / IA (análisis de comprobantes) ────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_INVENTORY_VISION_MODEL=gpt-4o

# ── API externa ────────────────────────────────────────────────────────────────
# Header X-API-Key para /api/v1/external/*.
EXTERNAL_API_KEY=

# ── Integración catálogo VIP / Render sync ─────────────────────────────────────
CATALOGO_VIP_BASE_URL=
CATALOGO_VIP_WEBHOOK_SECRET=
CATALOGO_VIP_DEFAULT_TEMP_PASSWORD=
VIP_CATALOG_BRIDGE_URL=
VIP_CATALOG_WEBHOOK_SECRET=
VIP_CATALOG_WEBHOOK_TIMEOUT=15
PUBLIC_PORTAL_BASE_URL=

# ── Códigos de retiro (integración física) ─────────────────────────────────────
CODIGOS_RETIRO_BASE_URL=
CODIGOS_RETIRO_WEBHOOK_API_KEY=
CODIGOS_RETIRO_ERP_NOTIFY_URL=
CODIGOS_RETIRO_ERP_NOTIFY_PATH=
CODIGOS_RETIRO_ERP_NOTIFY_API_KEY=
CODIGOS_RETIRO_ERP_NOTIFY_ENABLED=true
CODIGOS_RETIRO_ES_PRUEBA=false
CODIGOS_RETIRO_ERP_NOTIFY_TIMEOUT=12

# ── Auditoría (bitácora before/after) ──────────────────────────────────────────
# Kill switch: "0" desactiva la captura de auditoría en caliente sin desplegar.
AUDIT_ENABLED=1
# "1" propaga las excepciones del listener de auditoría en lugar de tragarlas
# (solo para tests/staging: en producción la auditoría nunca debe tumbar una
# transacción de negocio).
AUDIT_STRICT=0
