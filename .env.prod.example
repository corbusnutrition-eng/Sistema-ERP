# Plantilla del .env que docker-compose.prod.yml lee automáticamente desde
# la raíz del proyecto EN EL VPS. Copiar a `.env` junto a docker-compose.prod.yml
# (no commitear el `.env` real). Esto es independiente de `backend/.env`,
# que trae los secretos propios de la API (ver backend/.env.example).

# Imágenes publicadas en GHCR. El workflow de deploy las sobreescribe con el
# tag exacto del commit desplegado (ghcr.io/.../sistema-erp-backend:qa-<sha>);
# estos valores solo aplican si corres `docker compose up` a mano en el VPS.
BACKEND_IMAGE=ghcr.io/corbusnutrition-eng/sistema-erp-backend:qa
FRONTEND_IMAGE=ghcr.io/corbusnutrition-eng/sistema-erp-frontend:qa

# Puerto del host que expone el contenedor nginx (frontend). Cambiar si el
# VPS ya tiene un reverse proxy propio (Caddy/Traefik) delante en el 80/443.
FRONTEND_HTTP_PORT=80

# "production" activa las validaciones estrictas de arranque del backend
# (JWT_SECRET_KEY y CORS_ORIGINS obligatorias). Usar el mismo valor en QA.
ENVIRONMENT=production
